{
  "manifest_version": 3,
  "name": "Bilibili Downloader",
  "version": "1.2.1",
  "description": "Download Bilibili videos as regular MP4 files. Video and audio are merged locally without re-encoding.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Download this Bilibili video",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "downloads", "storage", "unlimitedStorage", "declarativeNetRequest"],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.bilivideo.com/*",
    "*://*.bilivideo.cn/*",
    "*://*.akamaized.net/*",
    "*://*.hdslb.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "cdn_referer", "enabled": true, "path": "rules.json" }
    ]
  }
}
